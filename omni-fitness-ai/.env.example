# =============================================================================
# PUBLIC VALUES ONLY. Everything here is inlined into the web bundle and is
# readable by anyone who opens the deployed app. Never put a credential here.
#
# Verified by:  npm run verify:secrets
#
# Secrets that are NOT listed here and must never be added:
#   HF_TOKEN, THRIVELENS_SERVING_API_KEY, any EXPO_TOKEN, any private key.
# Model credentials belong server-side (see ../serving/README.md).
# =============================================================================

# --- Optional: Supabase cloud sync -------------------------------------------
# The anon key is designed to be public and is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Optional: Google OAuth (Gmail sign-in) -----------------------------------
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Optional: ThriveLens Food-R1 inference backend (see ../serving/README.md) --
# URL ONLY. There is deliberately no client-side API key variable: a key placed
# here would be published in the bundle. The backend must be reached through an
# authenticated gateway, or run with THRIVELENS_SERVING_AUTH=dev for local mock.
EXPO_PUBLIC_INFERENCE_URL=http://127.0.0.1:8000

# --- Hugging Face ZeroGPU Space (free tier) ----------------------------------
# URL of the Gradio Space ONLY.
EXPO_PUBLIC_ZEROGPU_URL=https://ntatemasoabi-thrivelens-foodr1.hf.space

# --- ACCEPTED RISK: ZeroGPU quota token --------------------------------------
# Anonymous ZeroGPU callers share a small daily pool and start returning HTTP
# 402 ("exceeded your ZeroGPU runs limit") once it is spent. The owner has
# chosen to raise that ceiling by sending a token with each request.
#
# THE TOKEN IS PUBLIC. Anyone who opens the app or reads the bundle can extract
# it. It is therefore a QUOTA KEY, not a secret, and MUST satisfy all of:
#
#   1. READ-scoped only. A `write` token would let any visitor modify or delete
#      the Hugging Face account. The build FAILS if this is a write token.
#   2. Ideally scoped to the one Space (fine-grained token).
#   3. Rotated if it is ever exposed beyond the intended audience.
#
# Generate: https://huggingface.co/settings/tokens  ->  Read access.
# Never put a WRITE-scoped token in this file.
EXPO_PUBLIC_ZEROGPU_TOKEN=

# --- Optional: Google Maps (Maps tab) -----------------------------------------
# Web Maps JavaScript API key. This is public in the web bundle; restrict it
# in Google Cloud Console to deployed origins using HTTP referrer restrictions.
# Enable Maps JavaScript API for this key. Leave blank for the OSM map fallback.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Native SDK keys are read by app.config.js at prebuild/build time and are not
# inlined into the JavaScript bundle. Restrict each key by Android app identity
# (package + signing certificate) or iOS bundle ID, respectively. Enable Maps
# SDK for Android / Maps SDK for iOS. Rebuild the native app after changing.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Optional Google Places web-service key for nearby-place search. Public keys
# must be HTTP-referrer restricted. Enable Places API (Legacy) for this key;
# if unavailable, the Maps tab falls back to OpenStreetMap Overpass results.
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# =============================================================================
# REMOVED (kept as a warning so it is not reintroduced):
#   EXPO_PUBLIC_HF_TOKEN          - account credential, superseded by
#                                   EXPO_PUBLIC_ZEROGPU_TOKEN (read-scoped)
#   EXPO_PUBLIC_INFERENCE_TOKEN   - API key, would leak to all users
#
# No keys are needed for: SQLite, Drizzle, file photo logging, barcode lookup
# via Open Food Facts, or deterministic catalogue macros.
# =============================================================================
