# Free open-source stack — all optional. App runs 100% offline via expo-sqlite without these.

# Supabase (free Postgres) — optional cloud sync (+ authenticated gateway for model calls in release)
# Create at https://supabase.com → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google OAuth (free via expo-auth-session) — optional for Gmail sign-in
# Create at https://console.cloud.google.com → APIs & Services → Credentials → OAuth Client ID (Web)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ThriveLens Food-R1 inference service (see ../serving/README.md)
# Server-side model. DEV ONLY: use a mock/local instance. NEVER ship a live key in a public bundle.
EXPO_PUBLIC_INFERENCE_URL=http://127.0.0.1:8000
EXPO_PUBLIC_INFERENCE_TOKEN=

# ThriveLens Food-R1 on Hugging Face ZeroGPU (free, daily-cap). Primary path when set.
# URL of the Gradio Space, e.g. https://<user>-thrivelens-foodr1-zerogpu.hf.space
EXPO_PUBLIC_ZEROGPU_URL=
# Your HF token so ZeroGPU attributes GPU quota to YOUR account (visitor quota) instead of anonymous.
EXPO_PUBLIC_HF_TOKEN=

# No keys needed for: SQLite, Drizzle, file photo logging, deterministic catalogue macros

# Maps — real nearby registered stores/gyms (Maps tab). Default: OpenStreetMap Overpass,
# free and keyless. Set EXPO_PUBLIC_GOOGLE_PLACES_API_KEY to use Google Places instead.
# Create at https://console.cloud.google.com/apis/credentials (enable Places API).
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# LEGACY: EXPO_PUBLIC_HF_TOKEN was removed. Public Expo variables are bundle-visible and
# are not a secret boundary (ThriveLens blueprint §9.1). Model credentials stay server-side.