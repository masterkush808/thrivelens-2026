  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "serve:mock": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/serve-mock.ps1",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types \"tests/*.test.mts\"",
    "verify:secrets": "node scripts/check-bundle-secrets.mjs dist",
    "build:web": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && expo export --platform web --output-dir dist --clear",
    "deploy:web": "npm run build:web && npm run verify:secrets && npx eas-cli deploy --prod",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "private": true,
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
