THRIVELENS_BASE_MODEL=zy12123/Food-R1
THRIVELENS_ADAPTER_DIR=./models/thrivelens-foodr1-adapter
# HF Spaces deployment (optional). If THRIVELENS_ADAPTER_REPO is set and the
# adapter dir is empty at startup, the adapter is pulled from the Hub.
THRIVELENS_ADAPTER_REPO=
HF_TOKEN=
THRIVELENS_ADAPTER_SHA256=
THRIVELENS_SERVING_MOCK=1
THRIVELENS_SERVING_AUTH=dev
# Accepts: dev (open, for local mock only) or token (API-key gated). Any other
# value fails closed at startup. Real serving (mock=0) REQUIRES auth=token.
THRIVELENS_SERVING_API_KEY=
THRIVELENS_SERVING_HOST=127.0.0.1
THRIVELENS_SERVING_PORT=8000
THRIVELENS_MAX_IMAGE_BYTES=5242880
THRIVELENS_MAX_UPLOAD_PIXELS=40000000
THRIVELENS_MAX_CHAT_CHARS=4000
THRIVELENS_ABSTAIN_CONFIDENCE=0.45
THRIVELENS_MAX_NEW_TOKENS=192
THRIVELENS_COACH_MAX_NEW_TOKENS=384
# Server-side Open Food Facts catalogue fallback (public API, server-side only).
# Enable it for real barcode lookups via /v1/nutrition/lookup.
THRIVELENS_OFF_ENABLED=1
THRIVELENS_OFF_USER_AGENT=ThriveLens-2026/0.1
THRIVELENS_OFF_CACHE_DIR=
THRIVELENS_OFF_TIMEOUT_SECONDS=8.0
THRIVELENS_OFF_RETRIES=2
THRIVELENS_OFF_CACHE_TTL_SECONDS=86400